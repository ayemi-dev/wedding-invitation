# Copia este archivo como .env y rellena los valores.
# .env está en .gitignore: nunca se versiona.

# Llave de la API de Google Maps, para los mapas interactivos de la
# ceremonia y la recepción.
#
# Una llave de Maps del lado del cliente siempre acaba visible en el paquete
# que descarga el navegador: eso no se puede evitar. Lo que la protege es
# restringirla en la consola de Google Cloud:
#   console.cloud.google.com > APIs y servicios > Credenciales > la llave
#   Restricciones de aplicación > Sitios web (referentes HTTP)
#   Añadir:  https://my-wedding-invitation.ayemi.org/*
#   Restricciones de API > solo Maps JavaScript API
#
# Si se deja vacía, los mapas se sustituyen por un enlace a Google Maps y
# el resto del sitio funciona igual.
VITE_GOOGLE_MAPS_KEY=

# Aviso por WhatsApp cuando alguien confirma asistencia, vía CallMeBot.
# Solo hacen falta si se vuelve a activar la captura de confirmaciones
# (SOLO_LECTURA = false en src/config.js). Si faltan, no se envía nada.
VITE_WHATSAPP_PHONE=
VITE_CALLMEBOT_APIKEY=
